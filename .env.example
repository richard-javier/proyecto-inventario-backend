NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DB_HOST=localhost
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_DATABASE=tu_base_mysql
JWT_SECRET=cambia_este_valor

# URL pública del frontend. En producción debe usar HTTPS.
FRONTEND_URL=https://tu-dominio-frontend.com

# SMTP real o staging. No subas las credenciales reales al repositorio.
# TLS directo: SMTP_PORT=465 y SMTP_SECURE=true
# STARTTLS: SMTP_PORT=587 y SMTP_SECURE=false
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=password_o_api_key_smtp
EMAIL_FROM="SINCOT WMS <no-reply@tu-dominio.com>"

# Opcional si tu proveedor recomienda pooling o límites por segundo.
SMTP_POOL=false
SMTP_RATE_LIMIT=

# Opcional para alertas IA.
AI_AUDIT_ALERT_TO=seguridad@tu-dominio.com

RESET_TOKEN_EXPIRATION_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
